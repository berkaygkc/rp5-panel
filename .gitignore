# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# çalışma zamanı verisi (kalıcı bildirimler)
.data/

# izleme servislerinin verisi (infra/docker-compose.yml)
infra/beszel_data/
infra/kuma_data/

# Prisma üretilen istemci
lib/generated/

# AI tooling (local skills, lockfile)
.claude/
.agents/
skills-lock.json

# local databases and screenshots scratch
*.db
*.db-journal
